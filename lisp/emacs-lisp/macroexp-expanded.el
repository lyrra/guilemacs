(defun macroexp--backtrace nil "Return the Elisp backtrace, more recent frames first." (let ((bt nil) (i 0)) (while (let ((frame (backtrace-frame i))) (when frame (push frame bt) (setq i (1+ i))))) (nreverse bt)))

