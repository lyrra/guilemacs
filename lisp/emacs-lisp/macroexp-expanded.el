(defun macroexp-copyable-p (exp) "Return non-nil if EXP can be copied without extra cost." (or (symbolp exp) (macroexp-const-p exp)))

(defun macroexp-quote (v) "Return an expression E such that `(eval E)' is V.

E is either V or (quote V) depending on whether V evaluates to
