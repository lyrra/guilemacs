;;; test-m59-imp2.el --- M59 imp-2 face-attribute-relative-p real path.
;;;
;;; M59 imp-2 is the ONE real-path observable check for
;;; `face-attribute-relative-p' (docs/m59-plan.org, brief.org).  It is
;;; evidence only: the C delta is 0 and the Scheme delta is 0.
;;;
;;; The (m59) group of tool/run-tests.scm has NO `prelude' key, so
;;; tool/run-tests.scm runs the group through `run-tests-loadup-emacs':
;;;
;;;   ../src/emacs --no-init-file --no-site-file --no-site-lisp -L :.
;;;     -l ert -l <corpus> --batch --eval '(ert-run-tests-batch-and-exit ...)'
;;;
;;; So this corpus runs INSIDE the built src/emacs and a direct call to
;;; the subr is the REAL path.  No child process and no PTY case are
;;; necessary: the row is a pure value decision that reads no TTY, no
;;; redisplay, and no frame.
;;;
;;; It pins these groups:
;;;
;;;   S1 -- the observable: the 3 milestone values (:height 1.5 -> t,
;;;         :height 12 -> nil, :foreground unspecified -> t), the 5
;;;         branch controls that tell the 3 branches apart, and the 2
;;;         subr checks (subrp, arity error).  S1 holds 10 checks.
;;;   S2 -- the C row, re-measured: the DEFUN line, the 3 body tests,
;;;         and the 0 internal C callers of `Fface_attribute_relative_p'
;;;         inside src/xfaces.c.  S2 holds 3 checks.
;;;   S3 -- the registration in tool/run-tests.scm: the imp-2 line is
;;;         present exactly once, it follows the imp-1 line, the imp-1
;;;         line stays, and the (m58) group stays before (m59).  S3
;;;         holds 4 checks.
;;;   S4 -- the guards: one per-group min-count guard for each of S1 ..
;;;         S3 plus S4 itself, and the in-process group-total
;;;         `ert-deftest' that compares its own count with the sum of
;;;         the 4 group counts.  S4 holds 4 counted checks plus that
;;;         deftest.  A zero-check run is a false green, so the guards
;;;         make it FAIL.
;;;
;;; MEASURED VALUES (2026-10-19, HEAD c5ad1632a, built src/emacs):
;;;
;;;   (face-attribute-relative-p :height 1.5)                  => t
;;;   (face-attribute-relative-p :height 12)                   => nil
;;;   (face-attribute-relative-p :foreground 'unspecified)      => t
;;;   (face-attribute-relative-p :space-width 1.5)              => nil
;;;   (face-attribute-relative-p nil 1.5)                       => nil
;;;   (face-attribute-relative-p :foreground "red")             => nil
;;;   (face-attribute-relative-p :height 1)                     => nil
;;;   (face-attribute-relative-p :height 'unspecified)          => t
;;;   (face-attribute-relative-p :height :ignore-defface)       => t
;;;   (face-attribute-relative-p :foreground 'ignore-defface)   => nil
;;;   (subrp (symbol-function 'face-attribute-relative-p))      => t
;;;   (face-attribute-relative-p :height)  signals
;;;       wrong-number-of-arguments
;;;
;;; The values agree with the C body of src/xfaces.c and with brief.org
;;; section 4.  `QCignore_defface' is the KEYWORD :ignore-defface
;;; (src/xfaces.c :7468), not the SYMBOL 'ignore-defface, so the last
;;; control is the one that proves the second term of branch 1.
;;;
;;; This corpus reads TRACKED files only (src/, tool/run-tests.scm).  It
;;; does NOT read docs/ (docs/kb.org test-must-not-read-docs): a
;;; gitignored record can only pass or skip, so a record check proves
;;; nothing.  src/globals.h is GENERATED by the build and is NOT
;;; tracked, so this corpus does NOT pin a line of it: after a build it
;;; holds `EXFUN (Fface_attribute_relative_p, 2)' at :5226, and that
;;; fact is written here as a comment only.  That is also why the
;;; 0-internal-caller pin is scoped to src/xfaces.c: a tree-wide count
;;; over src/*.[ch] gives 2 occurrences on a built tree.
;;;
;;; A read error is a real error, never a silent pass.  An absent
;;; TRACKED file is a real FAIL, not a pass.  Every check registers a
;;; real ERT test via `imp-register-bool-as-ert-test', so the harness
;;; parses the ERT output and the exit code is correct.
;;;
;;; Every pin states its MEASURE UNIT: `m59-imp2--grep-c' counts LINES
;;; (the unit of `grep -c') and `m59-imp2--count' counts OCCURRENCES (the
;;; unit of `grep -o | wc -l').  The 2 counts differ on a file that holds
;;; 2 matches on 1 line: that is 1 LINE and 2 OCCURRENCES.

(princ "=== m59 imp-2 face-attribute-relative-p real-path suite ===\n")

(require 'imp-ert-report)

(defvar m59-imp2--root
  (file-name-as-directory
   (expand-file-name "../.." (file-name-directory (or load-file-name
                                                       default-directory)))))
(defvar m59-imp2--registered 0
  "Total number of checks this corpus has registered.")
(defvar m59-imp2--group nil
  "The group that `m59-imp2--check' counts into: `s1' .. `s4', or nil.")
(defvar m59-imp2--counts nil
  "Alist of (GROUP . COUNT) for the registered checks.")

(defun m59-imp2--group-count (group)
  "Number of checks registered so far in GROUP."
  (or (cdr (assq group m59-imp2--counts)) 0))

(defun m59-imp2--bump-group ()
  "Count one check into `m59-imp2--group'."
  (when m59-imp2--group
    (let ((cell (assq m59-imp2--group m59-imp2--counts)))
      (if cell
          (setcdr cell (1+ (cdr cell)))
        (push (cons m59-imp2--group 1) m59-imp2--counts)))))

(defun m59-imp2--with (rel fn)
  "Call FN in a temp buffer holding REL (repo-root-relative), or return
the symbol `m59-imp2-absent' when REL does not exist.  `case-fold-search'
is bound to nil: the elisp default is t, which folds `Guile' into
`guile' and over-counts a token in any file that holds both spellings.
Every pin in this corpus is case-SENSITIVE, like its grep command."
  (let ((path (expand-file-name rel m59-imp2--root)))
    (if (not (file-exists-p path))
        'm59-imp2-absent
      (with-temp-buffer
        (insert-file-contents path)
        (let ((case-fold-search nil))
          (funcall fn))))))

(defun m59-imp2--holds-all (rel needles)
  "Non-nil when the TRACKED file REL holds every NEEDLE.  REL is read
once, so a multi-needle check does not re-read the file per needle."
  (m59-imp2--with rel
    (lambda ()
      (let ((all t))
        (dolist (needle needles)
          (goto-char (point-min))
          (unless (search-forward needle nil t) (setq all nil)))
        all))))

(defun m59-imp2--live-p (rel needle)
  "Non-nil when the TRACKED file REL holds NEEDLE on a line that is NOT
commented out.  A needle that sits only on a comment registers no test,
so this skips a line whose first non-blank character is `;'."
  (m59-imp2--with rel
    (lambda ()
      (goto-char (point-min))
      (let ((hit nil))
        (while (and (not hit) (search-forward needle nil t))
          (setq hit (save-excursion
                      (goto-char (line-beginning-position))
                      (not (looking-at-p "[ \t]*;")))))
        hit))))

(defun m59-imp2--ordered-p (rel needles)
  "Non-nil when the TRACKED file REL holds every NEEDLE in the GIVEN
ORDER: each search starts after the previous match."
  (m59-imp2--with rel
    (lambda ()
      (goto-char (point-min))
      (let ((all t))
        (dolist (needle needles)
          (when all
            (unless (search-forward needle nil t) (setq all nil))))
        all))))

(defun m59-imp2--grep-c (rel regexp)
  "Count the LINES of REL that match REGEXP, the unit of `grep -c'.
A line with 3 matches counts 1, not 3."
  (m59-imp2--with rel
    (lambda ()
      (goto-char (point-min))
      (let ((n 0))
        (while (not (eobp))
          (when (re-search-forward regexp (line-end-position) t)
            (setq n (1+ n)))
          (forward-line 1))
        n))))

(defun m59-imp2--count (rel regexp)
  "Count the OCCURRENCES of REGEXP in REL, the unit of `grep -o | wc -l'.
This is NOT the unit of `grep -c': use `m59-imp2--grep-c' for a pin
whose brief command is `grep -c'."
  (m59-imp2--with rel
    (lambda ()
      (goto-char (point-min))
      (let ((n 0))
        (while (re-search-forward regexp nil t) (setq n (1+ n)))
        n))))

(defun m59-imp2--line-of (rel regexp)
  "Return the 1-based line number of the first REGEXP match in REL, or
nil when REGEXP does not match.  The reader returns the symbol
`m59-imp2-absent' when REL does not exist, so the caller's `eql' folds
to nil and the check FAILS."
  (m59-imp2--with rel
    (lambda ()
      (goto-char (point-min))
      (when (re-search-forward regexp nil t)
        (let ((end (match-beginning 0)) (n 1))
          (goto-char (point-min))
          (while (search-forward "\n" end t) (setq n (1+ n)))
          n)))))

(defun m59-imp2--line-number-here ()
  "Return the 1-based line number of point in the current buffer."
  (let ((target (point)))
    (save-excursion
      (goto-char (point-min))
      (let ((n 1))
        (while (search-forward "\n" target t) (setq n (1+ n)))
        n))))

(defun m59-imp2--sites (rel regexp)
  "Return the 1-based line numbers of the matches of REGEXP in REL,
EXCEPT a line whose first non-blank text is `DEFUN ('.  So the result is
the caller map of a subr, not its own definition.  A symbol (an absent
file) is returned unchanged, so the caller's `equal' folds to nil."
  (m59-imp2--with rel
    (lambda ()
      (goto-char (point-min))
      (let ((sites nil))
        (while (re-search-forward regexp nil t)
          (let ((line (m59-imp2--line-number-here))
                (defun-line-p (save-excursion
                                (goto-char (line-beginning-position))
                                (looking-at-p "[ \t]*DEFUN ("))))
            (unless (or defun-line-p (memq line sites))
              (push line sites))))
        (nreverse sites)))))

(defun m59-imp2--rel-p (&rest args)
  "Call the real subr `face-attribute-relative-p' with ARGS and return
its value, or the symbol `m59-imp2-call-error' when the call signals.
The guard keeps a missing or shadowed subr a real FAIL instead of an
error that aborts the whole corpus load."
  (condition-case _err
      (apply #'face-attribute-relative-p args)
    (error 'm59-imp2-call-error)))

(defun m59-imp2--check (name ok)
  "Report and register one check on a TRACKED file.  OK is a boolean.
When the source file is absent the reader returns the symbol
`m59-imp2-absent', so `eql' yields nil and this prints FAIL.  Either way
this registers a real FAILING ERT test, so an absent TRACKED file is a
real error, not a pass."
  (let* ((absent (eq ok 'm59-imp2-absent))
         (pass (and (not absent) (and ok t))))
    (if absent
        (princ (format "FAIL m59/imp2/%s (source file absent)\n" name))
      (princ (format "%s m59/imp2/%s\n" (if pass "PASS" "FAIL") name)))
    (setq m59-imp2--registered (1+ m59-imp2--registered))
    (m59-imp2--bump-group)
    (imp-register-bool-as-ert-test (format "m59-imp2/%s" name) pass)))

;; This corpus needs NO INFO skip helper: the (m59) group runs the corpus
;; inside the built src/emacs, so the 2 subr checks never depend on a
;; host limit.  A missing or shadowed subr FAILS the check; see
;; `m59-imp2--rel-p'.

;;; --- S1. The observable on the REAL path ----------------------------

;; The corpus runs inside the built src/emacs, so these are direct calls
;; to the C subr.  Expected values come from the C body of
;; src/xfaces.c :4173 ... :4193, MEASURED at HEAD c5ad1632a on
;; 2026-10-19 (see the header table).
;;
;; Branch 1: VALUE is `unspecified' or the keyword :ignore-defface.
;; Branch 2: ATTRIBUTE is :height and VALUE is a fixnum -> nil.
;; Branch 3: anything else -> nil.

(setq m59-imp2--group 's1)

;; The 3 values the milestone requires.
(m59-imp2--check "s1/height-1.5-t"
                 (eq t (m59-imp2--rel-p :height 1.5)))
(m59-imp2--check "s1/height-12-nil"
                 (null (m59-imp2--rel-p :height 12)))
(m59-imp2--check "s1/foreground-unspecified-t"
                 (eq t (m59-imp2--rel-p :foreground 'unspecified)))

;; The 5 controls.  They show that the check tells the 3 branches apart:
;; a check that passes on any input is not a proof.
;;
;; Branch 3: an absolute :foreground value.
(m59-imp2--check "s1/foreground-absolute-nil"
                 (null (m59-imp2--rel-p :foreground "red")))
;; Branch 2 with FIXNUMP true: a plain integer height is absolute.
(m59-imp2--check "s1/height-integer-1-nil"
                 (null (m59-imp2--rel-p :height 1)))
;; Branch 1 wins over branch 2: `unspecified' is tested first.
(m59-imp2--check "s1/height-unspecified-t"
                 (eq t (m59-imp2--rel-p :height 'unspecified)))
;; Branch 1, second term: QCignore_defface is the KEYWORD
;; :ignore-defface (src/xfaces.c :7468), so it short-circuits the
;; :height branch even for a fixnum-like keyword argument.
(m59-imp2--check "s1/height-ignore-defface-t"
                 (eq t (m59-imp2--rel-p :height :ignore-defface)))
;; The SYMBOL 'ignore-defface is NOT the keyword, so branch 1 misses and
;; the absolute :foreground falls through to branch 3 -> nil.  This is
;; the control that proves the pin is on the keyword, not on the name.
(m59-imp2--check "s1/foreground-ignore-defface-nil"
                 (null (m59-imp2--rel-p :foreground 'ignore-defface)))

;; Proof that the call reaches the REAL subr and not a Lisp shadow.  A
;; `fboundp' alone is not proof, and a module-load probe is not proof
;; either: a Lisp redefinition would still be `fboundp'.
(m59-imp2--check "s1/subr-p"
                 (and (fboundp 'face-attribute-relative-p)
                      (subrp (symbol-function 'face-attribute-relative-p))
                      t))
;; The C DEFUN declares the arity 2, 2, 0, so a 1-argument call signals
;; an error.  MEASURED error symbol: `wrong-number-of-arguments'.  Any
;; non-error result is a FAIL, because that would prove a Lisp shadow
;; with a permissive arglist.
(m59-imp2--check "s1/arity-error"
                 (let ((err (condition-case e
                                (progn (face-attribute-relative-p :height)
                                       nil)
                              (error (car e)))))
                   (and err (eq err 'wrong-number-of-arguments))))

;;; --- S2. The C row, re-measured -------------------------------------

;; Re-measure the C row at HEAD.  Do NOT copy a planning number: a moved
;; line is a finding, so the pin FAILS when the row moves.

(setq m59-imp2--group 's2)

;; The DEFUN line.  MEASURED at HEAD c5ad1632a: :4173.
(m59-imp2--check "s2/defun-line"
                 (let ((got (m59-imp2--line-of
                             "src/xfaces.c"
                             "^DEFUN (\"face-attribute-relative-p\"")))
                   (unless (eql 4173 got)
                     (princ (format "m59 imp2: the DEFUN moved, measured line: %s\n"
                                    got)))
                   (eql 4173 got)))

;; The 3 body tests, in the TRACKED C source.
(m59-imp2--check "s2/body-tests"
                 (m59-imp2--holds-all
                  "src/xfaces.c"
                  '("if (EQ (value, Qunspecified) || (EQ (value, QCignore_defface)))"
                    "else if (EQ (attribute, QCheight))"
                    "return FIXNUMP (value) ? Qnil : Qt;")))

;; 0 internal C callers.  Scope: src/xfaces.c ONLY, unit OCCURRENCES.  A
;; tree-wide count over src/*.[ch] is 2 on a built tree, because the
;; generated src/globals.h holds the EXFUN; that header is NOT tracked
;; and is NOT pinned.
(m59-imp2--check "s2/no-internal-c-caller"
                 (let ((n (m59-imp2--count "src/xfaces.c"
                                           "Fface_attribute_relative_p")))
                   (unless (eql 1 n)
                     (princ (format "m59 imp2: %s occurrences of Fface_attribute_relative_p in src/xfaces.c; caller sites: %S\n"
                                    n
                                    (m59-imp2--sites "src/xfaces.c"
                                                     "Fface_attribute_relative_p"))))
                   (eql 1 n)))

;;; --- S3. The registration in tool/run-tests.scm ----------------------

(setq m59-imp2--group 's3)

;; Unit: LINES (the unit of `grep -c').  Exactly ONE line names the
;; corpus, so a duplicate registration FAILS.
(m59-imp2--check "s3/imp2-in-m59-group"
                 (eql 1 (m59-imp2--grep-c "tool/run-tests.scm"
                                          "test/m59/test-m59-imp2\\.el")))
(m59-imp2--check "s3/after-imp1"
                 (m59-imp2--ordered-p
                  "tool/run-tests.scm"
                  '("test/m59/test-m59-imp1.el"
                    "test/m59/test-m59-imp2.el")))
(m59-imp2--check "s3/imp1-line-present"
                 (m59-imp2--live-p "tool/run-tests.scm"
                                   "test/m59/test-m59-imp1.el"))
(m59-imp2--check "s3/m58-group-present"
                 (m59-imp2--ordered-p "tool/run-tests.scm"
                                      '("(group (m58)" "(group (m59)")))

;;; --- S4. The guards -------------------------------------------------

;; The guards make a zero-check run FAIL: an --filter that matches no
;; group already reports exit 0 with 0 tests, so a green m59 gate proves
;; nothing until the checks really register.  S1 holds 10 checks, S2
;; holds 3, S3 holds 4, and S4 holds 4.

(setq m59-imp2--group 's4)

(m59-imp2--check "s4/min-s1-checks-10" (>= (m59-imp2--group-count 's1) 10))
(m59-imp2--check "s4/min-s2-checks-3" (>= (m59-imp2--group-count 's2) 3))
(m59-imp2--check "s4/min-s3-checks-4" (>= (m59-imp2--group-count 's3) 4))
;; The s4 guard reads its OWN group, so the count is still 3 while this
;; check is evaluated: the check itself is counted after its argument is
;; computed.  So add 1.  MEASURED: without the 1+ the check FAILS.
(m59-imp2--check "s4/min-s4-checks-4" (>= (1+ (m59-imp2--group-count 's4)) 4))

;;; --- The group-total check ------------------------------------------

;; The measured count of m59-imp2 tests is 22: 21 registered checks
;; (S1 10, S2 3, S3 4, S4 4) plus this group-total deftest itself.  The
;; total must equal the sum of the 4 group counts plus 1, so a check that
;; silently stops registering FAILS here.

(ert-deftest m59-imp2/gate-m59-total ()
  "The m59-imp2 corpus registers exactly the sum of its group counts."
  (should (= (length (ert-select-tests "^m59-imp2" t))
             (+ 1
                (m59-imp2--group-count 's1)
                (m59-imp2--group-count 's2)
                (m59-imp2--group-count 's3)
                (m59-imp2--group-count 's4)))))

(princ (format "=== m59 imp-2 suite done (%d checks; s1 %d, s2 %d, s3 %d, s4 %d) ===\n"
               m59-imp2--registered
               (m59-imp2--group-count 's1)
               (m59-imp2--group-count 's2)
               (m59-imp2--group-count 's3)
               (m59-imp2--group-count 's4)))
