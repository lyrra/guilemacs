;; The arguments given to this program are all the C files
;; of GNU Emacs.  .c files are allowed.
;; A .o file can also be specified; the .c file it was made from is used.
;; This helps the makefile pass the correct list of files.
;; Option -d DIR means change to DIR before looking for files.

;; The results, which go to standard output or to a file
;; specified with -a or -o (-a to append, -o to start from nothing),
;; are entries containing function or variable names and their documentation.
;; Each entry starts with a ^_ character.
;; Then comes F for a function or V for a variable.
;; Then comes the function or variable name, terminated with a newline.
;; Then comes the documentation for that function or variable.

(use-modules (srfi srfi-9))
(use-modules (ice-9 match)
             (ice-9 format)
             (ice-9 string-fun)
             (ice-9 textual-ports))

(define-syntax LLL
  (syntax-rules ()
    ((_ fmt . args)
     (apply format (list (current-error-port) fmt . args)))))

(define-syntax decf
  (syntax-rules ()
    ((_ var)
     (set! var (1- var)))))
(define-syntax incf
  (syntax-rules ()
    ((_ var)
     (set! var (1+ var)))))

;; ------------------------------------------------
;; similar to (ice-9 streams)

(define %charstack #f)

(define (getc s)
  (if (null? %charstack)
      (get-char s)
      (let ((c (car %charstack)))
        (set! %charstack (cdr %charstack))
        c)))

(define (ungetc c s)
  (set! %charstack (cons c %charstack)))

(define (make-fstream filename)
  (set! %charstack '())
  (open-input-file filename))

(define (fstream-eof? s)
  (eof-object? (lookahead-char s)))


(define (fstream-read-integer-acc s acc)
  (if (eof-object? s)
    acc
    (let ((c (getc s)))
      (cond
       ((char-numeric? c)
        (let ((n (- (char->integer c) 48)))
          (fstream-read-integer-acc s
                                    (if acc
                                        (+ (* acc 10) n)
                                        n))))
       (else
        (ungetc c s)
        acc)))))

(define (fstream-read-integer s)
  (fstream-read-integer-acc s #f))

(define (c-isspace c)
  (memq c
        (list #\Space
              #\Tab
              #\Newline
              ; v
              ; f
              #\Return)))

(define (c-isalpha c)
  (char-alphabetic? c))

(define (c-isalnum c)
  (or (char-alphabetic? c)
      (char-numeric? c)))

(define (c-toupper c)
  (char-upcase c))

(define (putchar c)
  (put-char (current-output-port) c))

(define (puts str)
  (display str)
  (newline))

(define (fputs str s)
  (display str (current-output-port)))

(define stdout 'stdout) ; dummy
(define %input-buffer #f)

;; ------------------------------------------------

;; True if this invocation is generating globals.h.
(define %generate-globals #f)

(define DEFUN_noreturn 1)
(define DEFUN_const 2)
(define DEFUN_noinline 4)
;; Print error message.  Args are like vprintf.

(define (verror m args)
  (apply format (append (list (current-error-port) m) args))
  (format (current-error-port) "~%"))

;; Print error message.  Args are like printf.

(define (print-error m . args)
  (verror m args))

;; Print error message and exit.  Args are like printf.

(define (fatal m . args)
  (verror m args)
  (exit 1))

;; Add a source file name boundary marker in the output file.
(define (put-filename filename)
  (let ((len (string-length filename))
        (new-filename filename))
    (do ((i 0 (1+ i)))
        ((>= i len))
      (if (file-name-separator? (string-ref filename i))
          (set! new-filename (substring filename i))))
    (format #t "~cS~a~%" (integer->char 31) filename)))

;; Read file FILENAME and output its doc strings to stdout.
;; Return true if file is found, false otherwise.  */

(define (scan-file filename)
  (when (not %generate-globals)
    (put-filename filename))
  (scan-c-file filename "r"))

(define (start-globals)
  (format #t "/* This file was auto-generated by make-docfile.  */~%")
  (format #t "/* DO NOT EDIT.  */~%")
  (format #t "struct emacs_globals {~%"))

;; Some state during the execution of `read_c_string_or_comment'.
(define-record-type <rcsoc>
  (make-rcsoc)
  rcsoc?
  ;; A count of spaces and newlines that have been read, but not output.
  (pending-spaces rcsoc-pending-spaces set-rcsoc-pending-spaces)
  (pending-newlines rcsoc-pending-newlines set-rcsoc-pending-newlines)

  ;; Where we're reading from.
  (in-file rcsoc-in-file  set-rcsoc-in-file)

  ;; If non-zero, a buffer into which to copy characters.
  (buf-ptr rcsoc-buf-ptr set-rcsoc-buf-ptr)

  ;; If non-zero, a file into which to copy characters.
  (out-file rcsoc-out-file set-rcsoc-out-file)

  ;; A keyword we look for at the beginning of lines.  If found, it is
  ;; not copied, and SAW_KEYWORD is set to true.
  (keyword rcsoc-keyword set-rcsoc-keyword)
  ;; The current point we've reached in an occurrence of KEYWORD in
  ;; the input stream.
  (cur-keyword-ptr rcsoc-cur-keyword-ptr set-rcsoc-cur-keyword-ptr)
  ;; Set to true if we saw an occurrence of KEYWORD.
  (saw-keyword rcsoc-saw-keyword set-rcsoc-saw-keyword))

(define (dec-rcsoc-pending-spaces r a)
  (set-rcsoc-pending-spaces r (- (rcsoc-pending-spaces r) a)))

(define (inc-rcsoc-pending-spaces r a)
  (set-rcsoc-pending-spaces r (+ (rcsoc-pending-spaces r) a)))

(define (dec-rcsoc-pending-newlines r a)
  (set-rcsoc-pending-newlines r (- (rcsoc-pending-newlines r) a)))

(define (inc-rcsoc-pending-newlines r a)
  (set-rcsoc-pending-newlines r (+ (rcsoc-pending-newlines r) a)))

(define (rcsoc-buf-ptr-put state c)
  (let* ((pair (rcsoc-buf-ptr state))
         (str (car pair))
         (idx (cdr pair)))
    (if (>= idx (string-length str))
        (set! str (string-concatenate (list str (format #f "~c" c))))
        (string-set! str idx c))
    (set-car! pair str)
    (set-cdr! pair (1+ idx))))

(define (charptr-put pair p c)
  (let* ((str (car pair)))
    (if (>= p (string-length str))
        (set! str (string-concatenate (list str (format #f "~c" c))))
        (string-set! str p c))
    (set-car! pair str)))

